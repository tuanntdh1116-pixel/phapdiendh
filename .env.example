# Sao chép file này thành ".env" và điền thông tin dự án Supabase của bạn.
# Lấy 2 giá trị này tại: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Nếu để trống, ứng dụng vẫn chạy được nhưng dữ liệu chỉ lưu trên
# từng trình duyệt (không dùng chung được giữa các đồng nghiệp).
